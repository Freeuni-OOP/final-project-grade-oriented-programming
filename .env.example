# Copy this file to .env before running docker compose up.
# .env itself is gitignored - keep real credentials out of git.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=Banking_System_db
MYSQL_USER=banking_user
MYSQL_PASSWORD=banking_pass

# --- Host port mappings ---
DB_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Backend ---
SPRING_PROFILES_ACTIVE=prod
# update: Hibernate creates/updates the schema from the JPA entities (safe default
#         for a fresh container). validate: expects the schema to already exist.
DDL_AUTO=update

# --- Frontend (baked into the build at build time, not read at runtime) ---
VITE_API_BASE_URL=http://localhost:8080